DATABASE_URL=postgresql://postgres:postgres@localhost:5432/amazon_profit
REDIS_URL=redis://localhost:6379

# Auth (better-auth) — apps/web/lib/auth-server.ts
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
# Must be the web app's own https URL in production — better-auth derives the
# session cookie's `secure` flag from this, so http here means non-secure cookies.
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated list of origins allowed to call the API / use better-auth (CORS + CSRF origin check).
TRUSTED_ORIGINS=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to "true" once sendResetPassword/sendVerificationEmail actually deliver mail (SMTP wired).
REQUIRE_EMAIL_VERIFICATION=false

# Amazon Selling Partner API (SP-API) — packages/amazon + apps/web OAuth routes + apps/worker live sync.
# Without these, mock connections and mock sync keep working; live "Connect Amazon" returns ?error=not_configured.
# LWA credentials from the Amazon Developer Console app (client type "Public client" / SP-API app).
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
# The SP-API application (client) id shown in Seller Central > Develop Apps ("ID" under Client).
AMAZON_SP_API_APP_ID=
# Registered "Redirect URI" (callback) of the Amazon app, e.g. https://<host>/api/v1/amazon/connections/seller-central/callback
AMAZON_REDIRECT_URI=
# AES-256-GCM key for encrypting stored refresh tokens: openssl rand -base64 32
AMAZON_TOKEN_ENCRYPTION_KEY=
# Default marketplace/region for new connections (US/NA unless overridden per connection).
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER
AMAZON_REGION=NA
# Optional: set to "beta" to pass version=beta through the authorization flow.
# AMAZON_APP_VERSION=beta
