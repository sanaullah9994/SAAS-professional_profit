DATABASE_URL=postgresql://postgres:postgres@localhost:5432/amazon_profit
REDIS_URL=redis://localhost:6379

# Auth (better-auth) — apps/web/lib/auth-server.ts
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
# Must be the web app's own https URL in production — better-auth derives the
# session cookie's `secure` flag from this, so http here means non-secure cookies.
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated list of origins allowed to call the API / use better-auth (CORS + CSRF origin check).
TRUSTED_ORIGINS=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to "true" once sendResetPassword/sendVerificationEmail actually deliver mail (SMTP wired).
REQUIRE_EMAIL_VERIFICATION=false
