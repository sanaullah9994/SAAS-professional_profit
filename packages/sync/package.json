{
  "name": "@amazon-profit/sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node -e \"console.log('sync: lint via TypeScript')\"",
    "test": "node -e \"console.log('sync: tests later')\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@amazon-profit/amazon": "workspace:*",
    "@amazon-profit/db": "workspace:*",
    "@amazon-profit/types": "workspace:*",
    "@amazon-profit/utils": "workspace:*",
    "pg": "^8.22.0"
  },
  "devDependencies": { "@types/node": "^26.1.1", "@types/pg": "^8.20.0", "typescript": "^6.0.3" }
}
