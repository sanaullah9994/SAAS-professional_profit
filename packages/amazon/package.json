    "test": "node -e \"console.log('amazon: tests later')\"",
    "clean": "rm -rf dist"
  },
  "dependencies": { "dotenv": "^17.4.2" },
  "devDependencies": { "@types/node": "^26.1.1", "typescript": "^6.0.3" }
